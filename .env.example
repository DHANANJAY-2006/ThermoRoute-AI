# ThermoRoute AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# FortyGuard Temperature API Key
# Get yours at: https://www.fortyguard.com/api-pricing
# After registering for the hackathon, your key will be emailed to you
FORTYGUARD_API_KEY=your_api_key_here

# Set to "true" to use demo data (no API key needed)
# Set to "false" to use live FortyGuard API
DEMO_MODE=true
